# Backend endpoints. Every consumer falls back to these exact values in code,
# so the app still works if this file is missing.
NEXT_PUBLIC_AUTH_URL=https://auth.vectoraero.ar
NEXT_PUBLIC_API_URL=https://api.vectoraero.ar

# Server-only. Las llamadas server-to-server (crons, webhooks, SSR) van por
# http://127.0.0.1:7477/api por defecto: el backend vive en el mismo VPS, y ese
# es su puerto real con el prefijo /api que sus rutas usan de verdad — nginx lo
# agrega solo cuando la llamada entra por el dominio público, así que sin
# nginx de por medio hay que ponerlo a mano (el corte del 2026-08-27 fue
# justamente pegarle a :7477 sin el /api). NEXT_PUBLIC_API_URL no entra en este
# default: es para el navegador, que no puede alcanzar el localhost del
# servidor. Setear API_URL acá sólo si el backend deja de estar en la misma
# máquina o cambia de puerto.
# API_URL=http://127.0.0.1:7477/api

# Gemini, for the AI copilot (chat widget + WhatsApp).
GEMINI_API_KEY=

# El proxy CONNECT para llegar a ANAC (MADHEL y NOTAM), que no acepta conexiones del VPS
# (`lib/anac.ts`, `infra/proxy-anac/`). En el VPS: http://100.71.80.77:8899 (oraclex64, por
# Tailscale). Sin esto, se le pega a ANAC directo, que es lo que anda en desarrollo.
# ANAC_PROXY=

# Kapso / WhatsApp Business.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Plantillas de WhatsApp aprobadas por Meta para los avisos de vencimiento. Van
# por entorno porque el nombre lo fija la aprobación, no el código: un envío
# proactivo no puede ser texto libre (Meta sólo lo permite dentro de las 24 h
# desde el último mensaje del piloto). Los defaults son los nombres cargados.
WHATSAPP_TEMPLATE_VENCIMIENTO=vencimiento_proximo
WHATSAPP_TEMPLATE_VENCIDO=documento_vencido
WHATSAPP_TEMPLATE_LANG=es_AR

# Shared with the backend's DOCUMENTS_ALERT_SECRET. Guards
# /api/cron/document-alerts and authenticates it against the backend sweep.
# Without it the cron refuses to run.
DOCUMENTS_ALERT_SECRET=

# Resend, para el briefing por mail del vuelo de mañana
# (/api/cron/briefing-vuelos). Sin esta clave el barrido corre, no manda nada y
# lo dice: no es un error, es la feature apagada.
#
# No hace falta verificar un dominio para arrancar: el remitente de prueba de
# Resend entrega al mail del titular de la cuenta, que es este caso. Un dominio
# propio mejora la entregabilidad cuando haya más de un piloto.
RESEND_API_KEY=
RESEND_FROM=

# A qué dominio contestan las oficinas (reply_to de los planes, ver lib/direccion-respuesta.ts).
# Sin esto, el viejo (respuestas.vector.fdiaznem.com.ar). Ponerlo en respuestas.vectoraero.ar
# recién cuando ese dominio esté verificado en Resend: el webhook acepta los dos siempre.
# DOMINIO_RESPUESTAS=respuestas.vectoraero.ar

# Dónde vive la app, para armar los links de los mails. Sin esto el briefing
# apunta al dominio de producción por defecto.
NEXT_PUBLIC_SITE_URL=https://vectoraero.ar

# El píxel de Meta, para medir los anuncios (ver src/lib/pixel-meta.ts). Opcional: sin el
# ID no se carga nada, ni el cartel de consentimiento. Next lo mete en el build, así que
# cambiarlo pide un deploy nuevo. En el Administrador de eventos de Meta, dejá apagada la
# "coincidencia avanzada automática".
NEXT_PUBLIC_META_PIXEL_ID=
